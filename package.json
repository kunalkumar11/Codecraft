{
  "name": "@kunalkumar11/codecraft",
  "version": "5.3.2",
  "displayName": "CodeCraft",
  "description": "CodeCraft provides lazy senior dev guidance for AI coding agents — the smallest change that fully solves the problem.",
  "keywords": ["opencode-plugin", "opencode", "codecraft", "pi-package", "pi", "skills", "qoder"],
  "license": "MIT",
  "author": {
    "name": "Kunal Kumar",
    "url": "https://github.com/kunalkumar11"
  },
  "homepage": "https://github.com/kunalkumar11/Codecraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunalkumar11/Codecraft.git"
  },
  "bugs": {
    "url": "https://github.com/kunalkumar11/Codecraft/issues"
  },
  "main": "./.opencode/plugins/codecraft.mjs",
  "exports": {
    ".": "./.opencode/plugins/codecraft.mjs",
    "./plugin": "./.opencode/plugins/codecraft.mjs"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "assets/codecraft-mark.svg",
    "docs/",
    "tools/codecraft_python_audit.py",
    "examples/python-audit-sample/",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/",
    "!pi-extension/test/",
    "scripts/uninstall.js",
    "scripts/cursor-hooks.js",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --prefix pi-extension",
    "setup": "node scripts/install-all.js",
    "doctor": "node scripts/install-all.js --dry-run"
  },
  "pi": {
    "extensions": ["./pi-extension/index.js"],
    "skills": ["./skills"]
  },
  "publishConfig": {
    "access": "public"
  }
}
